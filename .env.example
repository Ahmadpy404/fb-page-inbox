# FB Page Unified Inbox - Environment Configuration
# Copy this file to .env and fill in your Meta Developer and Page credentials.

# Server Port
PORT=3000

# SQLite Database Connection URL for Prisma
DATABASE_URL="file:./dev.db"

# Meta App Secret (found in Meta App Dashboard > App Settings > Basic > App Secret)
# Used to verify incoming webhook payloads (X-Hub-Signature-256)
APP_SECRET="your_meta_app_secret_here"

# Facebook Page Access Token (generated in App Dashboard > Messenger > Instagram/Facebook Settings > Token Generation)
# Used to send messages and backfill conversation history
PAGE_ACCESS_TOKEN="your_page_access_token_here"

# Webhook Verify Token (a custom random string you choose, entered into Meta Webhook Settings)
# Used during the GET /webhook/facebook verification handshake
VERIFY_TOKEN="your_custom_verify_token_here"

# Meta Graph API Base URL (defaults to v19.0)
GRAPH_API_BASE_URL="https://graph.facebook.com/v19.0"

# Client Port (for development)
CLIENT_PORT=5173
